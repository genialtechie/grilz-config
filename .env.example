VITE_POSTHOG_PROJECT_TOKEN=phc_your_project_token
VITE_POSTHOG_HOST=https://us.i.posthog.com

# AI photo render (server-side only, never prefix with VITE_)
FLUX_API_KEY=
# Optional daily budget guard (Upstash Redis free tier)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RENDER_DAILY_CAP=100

# Shopper phone codes (Firebase phone auth). Browser: the Firebase web app config.
# Without these, local dev uses "dev:" codes (any 6 digits) that the server takes only with ALLOW_DEV_PHONE=1.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Server: the service account JSON (one line), or just the project id (enough to check ID tokens).
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
# Salt for the stored phone hash behind the 3 free AI builds (falls back to LEAD_TOKEN_SECRET).
PHONE_HASH_SECRET=
# Local dev only; ignored on Vercel production.
ALLOW_DEV_PHONE=

# "Describe it" (server-side): uses OPENAI_API_KEY, like the studio photo.
OPENAI_API_KEY=
# Optional: model id (default set in server/describe.ts), reasoning effort (minimal|low|medium|high|none), AI builds per day across all shops (default 600).
OPENAI_DESCRIBE_MODEL=
OPENAI_DESCRIBE_EFFORT=
DESCRIBE_DAILY_LIMIT=
