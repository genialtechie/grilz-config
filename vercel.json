{
  "functions": {
    "api/render.ts": {
      "maxDuration": 120
    },
    "api/leads.ts": {
      "maxDuration": 60
    },
    "api/cron/marketing.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "missing": [
        {
          "type": "host",
          "value": "vvslab.magpollo.com"
        }
      ],
      "destination": "/api/shop-page?domain=1"
    },
    {
      "source": "/api/tenant/:slug",
      "destination": "/api/tenant?slug=:slug"
    },
    {
      "source": "/api/dashboard/:action",
      "destination": "/api/dashboard?action=:action"
    },
    {
      "source": "/api/unsubscribe",
      "destination": "/api/email?route=unsubscribe"
    },
    {
      "source": "/api/resend-webhook",
      "destination": "/api/email?route=resend-webhook"
    },
    {
      "source": "/b/:slug",
      "destination": "/api/shop-page?slug=:slug"
    },
    {
      "source": "/b/:slug/:path*",
      "destination": "/api/shop-page?slug=:slug"
    },
    {
      "source": "/watch",
      "destination": "/watch.html"
    },
    {
      "source": "/configurator",
      "destination": "/index.html"
    },
    {
      "source": "/signup",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/dashboard/:path*",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/dashboard",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/embed.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/retention",
      "schedule": "17 4 * * *"
    },
    {
      "path": "/api/cron/marketing",
      "schedule": "7 14 * * *"
    }
  ]
}
