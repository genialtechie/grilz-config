{
  "functions": {
    "api/render.ts": {
      "maxDuration": 120
    },
    "api/leads.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/tenant/:slug",
      "destination": "/api/tenant?slug=:slug"
    },
    {
      "source": "/api/dashboard/:action",
      "destination": "/api/dashboard?action=:action"
    },
    {
      "source": "/b/:slug",
      "destination": "/api/shop-page?slug=:slug"
    },
    {
      "source": "/b/:slug/:path*",
      "destination": "/api/shop-page?slug=:slug"
    },
    {
      "source": "/watch",
      "destination": "/watch.html"
    },
    {
      "source": "/configurator",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    }
  ]
}
