{
  "functions": {
    "api/render.ts": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/api/tenant/:slug",
      "destination": "/api/tenant?slug=:slug"
    },
    {
      "source": "/b/:slug",
      "destination": "/api/shop-page?slug=:slug"
    },
    {
      "source": "/b/:slug/:path*",
      "destination": "/api/shop-page?slug=:slug"
    },
    {
      "source": "/watch",
      "destination": "/watch.html"
    },
    {
      "source": "/configurator",
      "destination": "/index.html"
    }
  ]
}
